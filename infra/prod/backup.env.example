# Copy to /opt/krevo/repo/infra/prod/backup.env (bootstrap.sh does this). Kept apart from .env so the API never sees these keys.
# Database backups to Cloudflare R2 (a bucket separate from the files). Leave the keys empty to keep backups on the server only.
BACKUP_R2_BUCKET=krevo-backups
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS_LOCAL=7
BACKUP_KEEP_DAYS_REMOTE=30
# Dumps are encrypted with this before they leave the server. Keep a copy somewhere safe: without it a backup cannot be restored.
BACKUP_PASSPHRASE=
