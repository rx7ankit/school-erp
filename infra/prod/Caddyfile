# Caddy gets and renews the HTTPS certificate by itself once the DNS name points at this server.
{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 12MB
	}
	reverse_proxy api:8000 {
		health_uri /api/v1/health
		health_interval 15s
	}
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
