#!/usr/bin/env bash
# krevoctl: one command to run and look after the Krevo server. Run `krevoctl help`.
set -euo pipefail

ROOT=/opt/krevo
REPO=$ROOT/repo
DIR=$REPO/infra/prod
CONFIG=$ROOT/config
BACKUPS=$ROOT/backups
cd "$DIR"
dc() { docker compose --env-file "$CONFIG/.env" "$@"; }
envval() { cat "$CONFIG/.env" "$CONFIG/backup.env" 2>/dev/null | grep -E "^$1=" | head -1 | cut -d= -f2- || true; }

# The API must use a normal role: a superuser skips row level security, which is what keeps one school's data away
# from another. This creates the `krevo` role and database on first run and keeps the password in step with .env.
ensure_roles() {
  local pw; pw="$(envval APP_DB_PASSWORD)"
  [ -n "$pw" ] || { echo "APP_DB_PASSWORD is missing in $CONFIG/.env" >&2; return 1; }
  dc exec -T db psql -U krevo_admin -d postgres -v ON_ERROR_STOP=1 -v pw="$pw" >/dev/null <<'SQL'
select 'create role krevo login nosuperuser nobypassrls createdb' where not exists (select from pg_roles where rolname = 'krevo') \gexec
alter role krevo with login nosuperuser nobypassrls password :'pw';
select 'create database krevo owner krevo' where not exists (select from pg_database where datname = 'krevo') \gexec
SQL
}

cmd_deploy() {  # build the code in /opt/krevo/repo, back up, migrate, restart
  dc build api
  dc up -d --wait db redis
  ensure_roles
  if dc exec -T db psql -U krevo_admin -d krevo -Atc "select 1 from alembic_version limit 1" >/dev/null 2>&1; then
    cmd_backup pre-deploy
  fi
  dc run --rm -T api alembic upgrade head
  dc up -d --remove-orphans
  for i in $(seq 1 30); do
    if dc exec -T api python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/ready', timeout=4).status==200 else 1)" 2>/dev/null; then
      echo "Deployed $(cat "$REPO/VERSION" 2>/dev/null || echo "this code"). The API is healthy."
      docker image prune -f >/dev/null
      return 0
    fi
    sleep 2
  done
  echo "The API did not become healthy. Look at: krevoctl logs api" >&2
  return 1
}

# Runs every minute from cron. Pulls main from GitHub and deploys it once the tests for that exact commit have passed.
# Nothing needs to be set up on GitHub: the repository is public and the server only reads from it.
cmd_update() {  # krevoctl update [--now]  (--now skips waiting for the tests)
  exec 9>"$ROOT/.update.lock"; flock -n 9 || return 0
  cd "$REPO"
  git fetch -q origin main 2>/dev/null || return 0
  local new cur; new="$(git rev-parse origin/main)"; cur="$(cat "$ROOT/.deployed" 2>/dev/null || echo none)"
  [ "$new" = "$cur" ] && return 0
  if [ "${1:-}" != "--now" ]; then
    [ "$new" = "$(cat "$ROOT/.skipped" 2>/dev/null || true)" ] && return 0
    local slug state
    slug="$(git config --get remote.origin.url | sed -E 's#^.*github\.com[:/]##; s#\.git$##')"
    state="$(curl -fsS "https://api.github.com/repos/$slug/actions/runs?head_sha=$new&per_page=20" 2>/dev/null | python3 -c '
import json, sys
try:
    runs = json.load(sys.stdin).get("workflow_runs", [])
except Exception:
    print("unknown"); raise SystemExit
if not runs: print("waiting")
elif any(r.get("conclusion") in ("failure", "cancelled", "timed_out") for r in runs): print("failed")
elif all(r.get("status") == "completed" and r.get("conclusion") == "success" for r in runs): print("passed")
else: print("waiting")
' || echo unknown)"
    case "$state" in
      passed) ;;
      failed) echo "$(date '+%F %T') ${new:0:7}: tests failed, not deploying"; echo "$new" > "$ROOT/.skipped"; return 0 ;;
      *) return 0 ;;  # still testing, or GitHub not reachable: try again next minute
    esac
  fi
  echo "$(date '+%F %T') deploying ${new:0:7}"
  git reset -q --hard "$new"
  echo "${new:0:7}" > VERSION
  cd "$DIR"   # compose files live here; the git steps above ran in the repo root
  if cmd_deploy; then echo "$new" > "$ROOT/.deployed"; rm -f "$ROOT/.skipped"; else echo "$new" > "$ROOT/.skipped"; echo "deploy of ${new:0:7} failed (krevoctl logs api)" >&2; return 1; fi
}

cmd_backup() {  # krevoctl backup [label]: dump the database, keep it here, copy it to R2 if configured
  local label="${1:-daily}"
  mkdir -p "$BACKUPS"
  local name="krevo-$(date +%Y%m%d-%H%M%S)-$label.dump"
  local file="$BACKUPS/$name"
  dc exec -T db pg_dump -U krevo_admin -d krevo -Fc > "$file"
  [ -s "$file" ] || { echo "Backup is empty, something is wrong" >&2; rm -f "$file"; return 1; }
  dc exec -T db pg_restore --list < "$file" >/dev/null || { echo "Backup file is not readable" >&2; return 1; }
  if [ -n "$(envval BACKUP_PASSPHRASE)" ]; then
    openssl enc -aes-256-cbc -pbkdf2 -salt -pass "pass:$(envval BACKUP_PASSPHRASE)" -in "$file" -out "$file.enc"
    rm -f "$file"; file="$file.enc"; name="$name.enc"
  fi
  echo "Backup saved: $file ($(du -h "$file" | cut -f1))"
  if [ -n "$(envval BACKUP_R2_ACCESS_KEY_ID)" ] && [ -n "$(envval BACKUP_R2_ACCOUNT_ID)" ]; then
    export RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare RCLONE_CONFIG_R2_REGION=auto RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
    export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$(envval BACKUP_R2_ACCESS_KEY_ID)"
    export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$(envval BACKUP_R2_SECRET_ACCESS_KEY)"
    export RCLONE_CONFIG_R2_ENDPOINT="https://$(envval BACKUP_R2_ACCOUNT_ID).r2.cloudflarestorage.com"
    local bucket; bucket="$(envval BACKUP_R2_BUCKET)"
    rclone copyto "$file" "R2:$bucket/db/$name" && echo "Copied to R2: $bucket/db/$name"
    rclone delete "R2:$bucket/db" --min-age "$(envval BACKUP_KEEP_DAYS_REMOTE)d" || true
  else
    echo "R2 is not set up yet (BACKUP_R2_* in .env): this backup exists only on this server."
  fi
  find "$BACKUPS" -type f -name 'krevo-*' -mtime "+$(envval BACKUP_KEEP_DAYS_LOCAL)" -delete
}

cmd_restore() {  # krevoctl restore <file>: replace the database with a backup (asks first)
  local file="${1:?usage: krevoctl restore /opt/krevo/backups/<file>}"
  [ -f "$file" ] || { echo "No such file: $file" >&2; exit 1; }
  read -r -p "This REPLACES the live database with $file. Type YES to continue: " ok
  [ "$ok" = "YES" ] || { echo "Cancelled."; exit 1; }
  cmd_backup before-restore
  local plain="$file"
  if [[ "$file" == *.enc ]]; then
    plain="$(mktemp)"; openssl enc -d -aes-256-cbc -pbkdf2 -pass "pass:$(envval BACKUP_PASSPHRASE)" -in "$file" -out "$plain"
  fi
  dc stop api
  dc exec -T db psql -U krevo_admin -d postgres -c "drop database if exists krevo with (force)" -c "create database krevo owner krevo"
  dc exec -T db pg_restore -U krevo_admin -d krevo --role=krevo --no-owner < "$plain"
  [ "$plain" != "$file" ] && rm -f "$plain"
  dc up -d api
  echo "Restored from $file."
}

cmd_fetch_backup() {  # krevoctl fetch-backup: list the backups in R2
  export RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare RCLONE_CONFIG_R2_REGION=auto RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
  export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$(envval BACKUP_R2_ACCESS_KEY_ID)" RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$(envval BACKUP_R2_SECRET_ACCESS_KEY)"
  export RCLONE_CONFIG_R2_ENDPOINT="https://$(envval BACKUP_R2_ACCOUNT_ID).r2.cloudflarestorage.com"
  rclone ls "R2:$(envval BACKUP_R2_BUCKET)/db"
  echo "Download one with: rclone copyto R2:$(envval BACKUP_R2_BUCKET)/db/<name> $BACKUPS/<name>  (same RCLONE_CONFIG_R2_* env)"
}

cmd_job() {  # krevoctl job <name>: run a scheduled job now (late-fees, record-usage, platform-invoices, notification-cleanup, library-reminders, all)
  dc run --rm -T api python -m app.jobs.run "${1:?job name}"
}

cmd_owner() {  # krevoctl owner you@example.com 'Strong#Pass1' 'Your Name'
  dc run --rm -T api python scripts/create_owner.py "${1:?email}" "${2:?password}" "${3:-Krevo Owner}"
}

cmd_storage() {  # krevoctl storage <account_id> <access_key_id> <secret_access_key> [bucket]  (switches file uploads to Cloudflare R2)
  local acct="${1:-}" key="${2:-}" secret="${3:-}" bucket="${4:-krevo-files}"
  [ -n "$acct" ] && [ -n "$key" ] && [ -n "$secret" ] || { echo "usage: krevoctl storage <account_id> <access_key_id> <secret_access_key> [bucket]" >&2; return 1; }
  local f="$CONFIG/.env"
  setval() { if grep -q "^$1=" "$f"; then sed -i "s|^$1=.*|$1=$2|" "$f"; else echo "$1=$2" >> "$f"; fi; }
  cp "$f" "$f.bak"
  setval STORAGE_BACKEND r2; setval R2_ACCOUNT_ID "$acct"; setval R2_ACCESS_KEY_ID "$key"; setval R2_SECRET_ACCESS_KEY "$secret"; setval R2_BUCKET "$bucket"
  dc up -d --force-recreate api
  for i in $(seq 1 30); do
    if dc exec -T api python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/ready', timeout=4).status==200 else 1)" 2>/dev/null; then
      # Prove the keys work: sign a link, upload a few bytes to it, read them back, remove them.
      dc exec -T api python - <<'PY' && echo "R2 is working: bucket $bucket accepted a test file." && return 0
import asyncio, urllib.request, uuid
from app.services.storage import get_storage
async def main():
    s = get_storage(); key = f"healthcheck/{uuid.uuid4()}.txt"
    req = urllib.request.Request(await s.upload_url(key, "text/plain", 300), data=b"krevo", method="PUT", headers={"Content-Type": "text/plain"})
    urllib.request.urlopen(req, timeout=20)
    got = urllib.request.urlopen(await s.download_url(key, "check.txt", 300), timeout=20).read()
    assert got == b"krevo", got
    await s.delete(key)
asyncio.run(main())
PY
      echo "The API is up but the R2 test failed: $f.bak has the old settings. Check the keys and the bucket name." >&2; return 1
    fi
    sleep 2
  done
  echo "The API did not become healthy. Old settings are in $f.bak. Look at: krevoctl logs api" >&2; return 1
}

cmd_status() {
  dc ps
  echo; df -h /opt/krevo | tail -1; free -h | sed -n 2p
  echo; echo "Latest backups:"; ls -1t "$BACKUPS" 2>/dev/null | head -3 || true
  echo; curl -fsS "https://$(envval API_DOMAIN)/api/v1/health/ready" && echo || echo "(public health check failed: is DNS pointing here yet?)"
}

case "${1:-help}" in
  deploy) cmd_deploy ;;
  update) shift; cmd_update "$@" ;;
  backup) shift; cmd_backup "${1:-manual}" ;;
  restore) shift; cmd_restore "$@" ;;
  fetch-backup) cmd_fetch_backup ;;
  job) shift; cmd_job "$@" ;;
  owner) shift; cmd_owner "$@" ;;
  status) cmd_status ;;
  storage) shift; cmd_storage "$@" ;;
  logs) shift; dc logs --tail 200 -f "${@:-api}" ;;
  psql) dc exec db psql -U krevo_admin -d krevo ;;
  shell) dc exec api bash ;;
  restart) shift; dc restart "${@:-api}" ;;
  env) ${EDITOR:-nano} "$CONFIG/${2:-.env}"; echo "Now run: krevoctl deploy (or krevoctl restart api)" ;;
  help|*)
    cat <<'HELP'
krevoctl update [--now]      pull main and deploy (cron does this every minute once tests pass)
krevoctl deploy              rebuild what is on the server now, back up, migrate, restart
krevoctl storage <acct> <key> <secret> [bucket]   switch file uploads to Cloudflare R2 and test it
krevoctl status              what is running, disk, last backups, public health
krevoctl logs [service]      follow logs (api, db, redis, caddy)
krevoctl backup [label]      dump the database now (and copy to R2 when set up)
krevoctl restore <file>      replace the database from a backup file
krevoctl fetch-backup        list backups stored in R2
krevoctl job <name>          run a scheduled job now
krevoctl owner <email> <password> [name]   create the platform owner
krevoctl psql | shell        database prompt | shell in the API container
krevoctl env [backup.env]    edit the settings file (or the backup settings)
HELP
    ;;
esac
