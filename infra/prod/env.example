# Copy to /opt/slov/infra/prod/.env (bootstrap.sh does this and fills in the secrets). Never commit the real file.
API_DOMAIN=api.slov.tech

# Generated by bootstrap.sh
POSTGRES_PASSWORD=
JWT_SECRET=
BFF_SECRET=

# Browsers allowed to call the API directly (the web app)
CORS_ORIGINS=https://app.slov.tech
APP_BASE_URL=https://app.slov.tech
EMAIL_FROM=Slov <no-reply@slov.tech>

# Email: console until Resend is set up, then resend
EMAIL_BACKEND=console
RESEND_API_KEY=

# Files: memory until R2 is set up, then r2
STORAGE_BACKEND=memory
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slov-files

# Push: console until Firebase is set up, then fcm
PUSH_BACKEND=console
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=
