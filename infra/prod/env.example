# Copy to /opt/krevo/infra/prod/.env (bootstrap.sh does this and fills in the secrets). Never commit the real file.
API_DOMAIN=api.krevo.tech

# Generated by bootstrap.sh
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
BFF_SECRET=

# Browsers allowed to call the API directly (the web app)
CORS_ORIGINS=https://app.krevo.tech
APP_BASE_URL=https://app.krevo.tech
EMAIL_FROM=Krevo <no-reply@krevo.tech>

# Email: console until Resend is set up, then resend
EMAIL_BACKEND=console
RESEND_API_KEY=

# Files: memory until R2 is set up, then r2
STORAGE_BACKEND=memory
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=krevo-files

# Push: console until Firebase is set up, then apns (iPhones straight to Apple, Android through Firebase).
# FCM_SERVICE_ACCOUNT is the key JSON on one line in single quotes. See docs/android-push.md
PUSH_BACKEND=console
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=
