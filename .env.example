# Postgres 18 and Redis from infra/docker-compose.yml
POSTGRES_USER=scool
POSTGRES_PASSWORD=scool
POSTGRES_DB=scool_dev
DATABASE_URL=postgresql+asyncpg://scool:scool@localhost:5432/scool_dev
REDIS_URL=redis://localhost:6379/0

# Change in production
JWT_SECRET=change-me-to-a-long-random-string
# Email: console prints to the log (dev), resend sends for real, smtp is the fallback
EMAIL_BACKEND=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Scool <no-reply@scool.in>   # must be a domain verified in Resend
APP_BASE_URL=http://localhost:3000

# Files: memory (dev, nothing stored) or r2 (Cloudflare R2 bucket)
STORAGE_BACKEND=memory
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scool-files
