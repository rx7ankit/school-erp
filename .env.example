# Postgres 18 and Redis from infra/docker-compose.yml
POSTGRES_USER=scool
POSTGRES_PASSWORD=scool
POSTGRES_DB=scool_dev
DATABASE_URL=postgresql+asyncpg://scool:scool@localhost:5432/scool_dev
REDIS_URL=redis://localhost:6379/0

# Change in production
JWT_SECRET=change-me-to-a-long-random-string
EMAIL_BACKEND=console        # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Scool <no-reply@scool.in>
APP_BASE_URL=http://localhost:3000
