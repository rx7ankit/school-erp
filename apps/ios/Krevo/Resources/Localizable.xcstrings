    "error.invalid_credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong email or password. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल या पासवर्ड गलत है। कृपया फिर कोशिश करें।"
          }
        }
      }
    },
    "error.leave_dates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end date cannot be before the start date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम तारीख शुरू की तारीख से पहले नहीं हो सकती।"
          }
        }
      }
    },
    "error.leave_half": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A half day can only be applied for a single day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधे दिन की छुट्टी केवल एक दिन के लिए ली जा सकती है।"
          }
        }
      }
    },
    "error.leave_left": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave cannot be applied for a child who has left school."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस बच्चे ने स्कूल छोड़ दिया है, उसके लिए छुट्टी का आवेदन नहीं हो सकता।"
          }
        }
      }
    },
    "error.leave_not_pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a pending request can be cancelled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल लंबित आवेदन ही रद्द किया जा सकता है।"
          }
        }
      }
    },
    "error.leave_past": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave cannot start before today."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छुट्टी आज से पहले की तारीख से शुरू नहीं हो सकती।"
          }
        }
      }
    },
    "error.leave_reason": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a reason."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया कारण लिखें।"
          }
